{
  "name": "pln-ap2t-chatbot-standalone",
  "version": "1.0.0",
  "description": "PLN AP2T Chatbot - Netlify Deployment Ready",
  "main": "index.html",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "netlify-dev": "netlify dev",
    "build": "echo 'Static site - no build required'",
    "deploy": "netlify deploy --prod",
    "docker:build": "docker build -t pln-ap2t-chatbot:latest .",
    "docker:run": "docker run -p 3030:3030 --env-file .env pln-ap2t-chatbot:latest",
    "docker:compose": "docker-compose up -d",
    "docker:compose-down": "docker-compose down",
    "docker:push": "./docker-build-push.sh"
  },
  "keywords": ["pln", "ap2t", "chatbot", "ai", "assistant", "netlify", "serverless"],
  "author": "PLN Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "netlify-cli": "^17.0.0"
  }
}