# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# Netlify Deployment Instructions:
# 1. Go to Netlify Dashboard > Your Site > Site Settings > Environment Variables
# 2. Add new environment variable: OPENROUTER_API_KEY = your_actual_api_key
# 3. No need to copy this file for Netlify - just set the environment variable directly

# For Local Development:
# 1. Copy this file to .env
# 2. Replace 'your_openrouter_api_key_here' with your actual OpenRouter API key
# 3. Run: npm start

# Get your OpenRouter API key from: https://openrouter.ai/keys